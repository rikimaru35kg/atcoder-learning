{
    "window.zoomLevel": 1,
    "vim.handleKeys": {
        "<C-s>": false,
        "<C-z>": false,
    },
    "vim.useCtrlKeys": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {"before": ["U"], "after": ["<c-r>"]},
        {"before": ["j"], "after": ["g","j"]},
        {"before": ["k"], "after": ["g","k"]},
        {"before": ["<C-d>"], "after": ["g","b"]},
        {"before": ["m"], "after": ["5","<c-e>"]},
        {"before": ["t"], "after": ["5","<c-y>"]},
        {"before": ["<space>", "g"], "commands": ["workbench.view.search"]},
        {"before": ["<space>", "f"], "commands": ["workbench.action.quickOpen"]},
        {"before": ["<space>", "e"], "commands": ["workbench.action.toggleSidebarVisibility"]},   
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {"before": ["<C-d>"], "after": ["g","b"]},
    ],
    "vim.hlsearch": true,
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "update.mode": "manual",
    "extensions.autoUpdate": false,
    "editor.tokenColorCustomizations": {
        "numbers": "#2ee116",
        "[Default Dark Modern]": {
            "textMateRules": [
            {
                    "scope": "keyword.operator.bitwise",
                    "settings": {
                        "foreground": "#ff7700",
                        // "fontStyle": "bold"
                    }
                }
            ]
        }
    },
    "files.autoSave": "afterDelay",
    "editor.fontFamily": "'PlemolJP Console NF', Consolas, 'Courier New', monospace",
    "files.autoSaveDelay": 200,
    "workbench.colorTheme": "Visual Studio 2017 Dark - C++",
    "markdown-preview-enhanced.previewTheme": "github-dark.css",
    "markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "remote.SSH.remotePlatform": {
        "raspi": "linux"
    },
    "remote.autoForwardPortsSource": "hybrid",
}